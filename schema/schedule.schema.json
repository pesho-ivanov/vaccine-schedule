{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/vaccine-schedule/schedule.schema.json",
  "title": "Vaccine Schedule Rows",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "country", "rows"],
  "properties": {
    "version": { "const": 1 },
    "country": { "const": "BG" },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["vaccine", "group", "doses"],
        "properties": {
          "vaccine": { "$ref": "types.schema.json#/$defs/id" },
          "group": { "enum": ["mandatory", "recommended"] },
          "divider_after": { "type": "boolean" },
          "doses": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["column", "text"],
              "properties": {
                "column": { "$ref": "types.schema.json#/$defs/id" },
                "through": { "$ref": "types.schema.json#/$defs/id" },
                "text": { "type": "string", "minLength": 1 },
                "note": { "type": "string", "minLength": 1 },
                "mandatory": { "type": "boolean" },
                "muted": { "type": "boolean" },
                "struck": { "type": "boolean" },
                "note_style": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}
