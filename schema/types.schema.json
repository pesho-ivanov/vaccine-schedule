{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/vaccine-schedule/types.schema.json",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_]+$"
    },
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "bg"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "bg": { "type": "string", "minLength": 1 }
      }
    },
    "textBundle": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "minProperties": 1
    },
    "preBirthRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diseases", "column"],
      "properties": {
        "diseases": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "column": { "$ref": "#/$defs/id" }
      }
    }
  }
}
