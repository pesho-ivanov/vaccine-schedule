{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/vaccine-schedule/columns.schema.json",
  "title": "Vaccine Schedule Columns",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "country", "columns"],
  "properties": {
    "version": { "const": 1 },
    "country": { "const": "BG" },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "age_months"],
        "properties": {
          "id": { "$ref": "types.schema.json#/$defs/id" },
          "label": { "$ref": "types.schema.json#/$defs/localizedText" },
          "age_months": { "type": "number" }
        }
      }
    }
  }
}
