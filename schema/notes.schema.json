{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/vaccine-schedule/notes.schema.json",
  "title": "Vaccine Schedule Notes",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "country", "notes"],
  "properties": {
    "version": { "const": 1 },
    "country": { "const": "BG" },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["disease", "doses"],
        "properties": {
          "disease": { "$ref": "types.schema.json#/$defs/id" },
          "doses": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["column", "note"],
              "properties": {
                "column": { "$ref": "types.schema.json#/$defs/id" },
                "through": { "$ref": "types.schema.json#/$defs/id" },
                "note": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
