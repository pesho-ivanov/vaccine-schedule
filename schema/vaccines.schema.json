{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/vaccine-schedule/vaccines.schema.json",
  "title": "Vaccine Schedule Vaccines",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "country", "vaccines"],
  "properties": {
    "version": { "const": 1 },
    "country": { "const": "BG" },
    "vaccines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "$ref": "types.schema.json#/$defs/id" },
          "label": { "$ref": "types.schema.json#/$defs/localizedText" },
          "short": { "$ref": "types.schema.json#/$defs/localizedText" },
          "hover_label": { "$ref": "types.schema.json#/$defs/localizedText" },
          "record_aliases": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
